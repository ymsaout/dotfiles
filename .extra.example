#!/bin/bash
# ~/.extra — machine-local config, NOT committed to git
#
# Copy this file to ~/.extra and fill in your values.
# This file is sourced by ~/.bashrc after all other dotfiles.
#
# Use it for:
#   - Git identity (required — not stored in .gitconfig)
#   - API tokens and secrets
#   - Machine-specific PATH additions or overrides

# Git identity — required
export GIT_AUTHOR_NAME="Your Name"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_AUTHOR_EMAIL="you@example.com"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
export GITHUB_USER="your_github_username"

# API tokens
# export GITHUB_TOKEN=""
# export NPM_TOKEN=""

# Work-specific config
# export WORK_ENV="staging"
